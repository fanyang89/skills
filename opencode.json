{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "/private/tmp/**": "allow",
      "/tmp/**": "allow",
      "~/go/**": "allow",
      "~/.cargo/**": "allow",
      "~/.config/opencode": "allow"
    },
    "edit": {
      "/private/tmp/**": "allow",
      "/tmp/**": "allow",
      "~/go/**": "deny",
      "~/.cargo/**": "deny"
    }
  }
}
